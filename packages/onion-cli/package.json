{
  "name": "@onion-architect-ai/cli",
  "version": "4.1.0-beta.2",
  "description": "CLI para Sistema Onion - Multi-Context Development Orchestrator",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "onion": "bin/onion.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "keywords": [
    "onion",
    "cli",
    "ai-assistant",
    "cursor",
    "windsurf",
    "claude",
    "spec-driven-development",
    "multi-context"
  ],
  "author": "Sistema Onion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onion-architect-ai/onion-architect.git"
  },
  "homepage": "https://github.com/onion-architect-ai/onion-architect#readme",
  "bugs": {
    "url": "https://github.com/onion-architect-ai/onion-architect/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.12",
    "ora": "^8.1.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
